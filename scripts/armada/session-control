#!/usr/bin/bash
set -euo pipefail

state_file="/var/home/armada/.config/armada-session-state"
mkdir -p "$(dirname "$state_file")"
chown armada:armada "$(dirname "$state_file")" 2>/dev/null || true

case "${1:-}" in
    switch-desktop)
        echo "desktop" > "$state_file"
        killall -9 gamescope || true
        ;;
    switch-gamemode) 
        echo "gamemode" > "$state_file"
        killall -9 kwin_wayland || true
        ;;
    default-gamemode) 
        echo "gamemode" > "$state_file"
        ;;
    *) echo "usage: $0 {switch-desktop|switch-gamemode|default-gamemode}" >&2; exit 1 ;;
esac
chown armada:armada "$state_file" 2>/dev/null || true
